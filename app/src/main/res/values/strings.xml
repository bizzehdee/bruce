    <string name="skill_delete_file">Delete files</string>
    <string name="skill_delete_file_summary">Deletes single files inside folders you have granted. Deleted files cannot be recovered.</string>
    <string name="skill_find_settings">Find settings</string>
    <string name="skill_find_settings_summary">Looks up which phone settings Bruce knows about, such as brightness or Wi-Fi. Reads nothing from the phone.</string>
    <string name="skill_get_setting">Read settings</string>
    <string name="skill_get_setting_summary">Reads the current value of a phone setting, such as screen timeout or whether Bluetooth is on.</string>
    <string name="skill_set_setting">Change settings</string>
    <string name="skill_set_setting_summary">Changes brightness, adaptive brightness, screen timeout, auto-rotate, vibrate on touch and volumes. Needs Modify system settings in Permissions for all but volumes.</string>
    <string name="skill_open_settings_page">Open settings pages</string>
    <string name="skill_open_settings_page_summary">Opens the phone\'s settings page for a setting Bruce cannot change, such as Wi-Fi, so you can change it.</string>
